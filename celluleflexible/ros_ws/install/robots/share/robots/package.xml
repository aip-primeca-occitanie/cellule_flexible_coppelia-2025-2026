<?xml version="1.0"?>
<package format="3">
  <name>robots</name>
  <version>3.1.2</version>
  <description>The robots package</description>
  <maintainer email="simon.demmer@etu.enseeiht.fr">Simon Demmer</maintainer>
  <author>Emilie, Thibaut, Clement et Simon</author>
  <license>GPLv3</license>
  <url type="website">http://www.fr</url>

  <!-- Build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Build dependencies -->
  <build_depend>rclcpp</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>commande_locale</build_depend>
  <build_depend>shuttles</build_depend>
  <build_depend>rosidl_default_generators</build_depend>
  
  
  <!-- Run dependencies -->
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  
  
  <member_of_group>rosidl_interface_packages</member_of_group>
  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
